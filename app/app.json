{
  "expo": {
    "name": "NIBI-GO",
    "slug": "nibi-go",
    "version": "0.1.5",
    "scheme": "nibigo",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "top.nibistudio.nibigo",
      "versionCode": 6
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 NIBI-GO 使用相机扫描桌面端二维码。"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 NIBI-GO 选择图片作为对话附件。",
          "cameraPermission": "允许 NIBI-GO 使用相机拍摄附件。",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "./plugins/withCmakeVersion",
      "./plugins/withReleaseSigning",
      "./plugins/withKernelAndroidTrust",
      "./plugins/withAndroidLegacyPackaging"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
