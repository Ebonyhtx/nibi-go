# NIBI-GO 构建期环境变量示例（复制为 .env.local 使用；.env.local 已被 gitignore）
# 这些值都会打进 JS bundle（EXPO_PUBLIC_ 前缀），不要放任何秘密。

# NIBI-GO 的 OIDC native app client id（NIBI 账号中心注册，回调 nibigo://login）
# client id 是 OAuth 公开标识，不是密钥。
EXPO_PUBLIC_NIBI_GO_OIDC_CLIENT_ID=

# 联调覆盖（缺省使用生产端点）
# EXPO_PUBLIC_NIBI_ENDPOINT_ORIGIN=https://api.nibistudio.top
# EXPO_PUBLIC_NIBI_RELAY_WS_URL=wss://api.nibistudio.top/api/v1/remote/ws2
# EXPO_PUBLIC_NIBI_AUTH_ORIGIN=https://auth.nibistudio.top

# 应用内更新发布仓（owner/repo）
# EXPO_PUBLIC_NIBI_RELEASE_REPO=Ebonyhtx/nibi-go
